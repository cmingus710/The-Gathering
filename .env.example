# Copy to .env.local for local development. Never commit real values.

# --- Supabase (Project Settings → API) ---
NEXT_PUBLIC_SUPABASE_URL=
# Publishable key (sb_publishable_…). The legacy anon key also works via NEXT_PUBLIC_SUPABASE_ANON_KEY.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Absolute site URL used in auth email links. Set in production; on Vercel
# previews it falls back to VERCEL_BRANCH_URL automatically.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Cloudflare Turnstile (sign-up / sign-in CAPTCHA) ---
# Public site key. Unset = no widget. Locally use Cloudflare's test key
# 1x00000000000000000000AA. The secret key goes only in Supabase's CAPTCHA
# settings, never here. See docs/turnstile-captcha.md.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# --- Resend (app notifications such as "membership approved") ---
# Optional: when unset, approvals still work and admins are told no email was sent.
RESEND_API_KEY=
EMAIL_FROM="The Gathering <hello@your-verified-domain.org>"

# --- Operator scripts only (never exposed to the app or the browser) ---
# Secret key (sb_secret_…) or legacy service_role key. Used by scripts/bootstrap-super-admin.mjs.
SUPABASE_SECRET_KEY=

# --- Tests only ---
# Postgres superuser URL for the RLS integration tests (creates a throwaway database).
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/postgres
